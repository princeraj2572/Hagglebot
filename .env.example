# Copy to .env.local (never committed). SANDBOX credentials only.
# Create an app at https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox personal (buyer) and business (seller) accounts:
# https://developer.paypal.com/dashboard/accounts
# PAYPAL_BUYER_EMAIL is only shown in the UI as a hint for which sandbox account to log in with.
PAYPAL_BUYER_EMAIL=
# IMPORTANT: this must be the sandbox BUSINESS account that owns the REST app above (PayPal rejects
# other payees without partner permissions). Leave blank to pay the app's own account.
PAYPAL_SELLER_EMAIL=

# LLM keys (free tiers). Gemini is primary; Groq is used when Gemini is rate-limited.
# https://aistudio.google.com/apikey  and  https://console.groq.com/keys
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional: milliseconds to wait between negotiation steps so the dashboard feels live
# (default 1200; set 0 for instant). Useful for the demo video.
HAGGLEBOT_STEP_DELAY_MS=1200
