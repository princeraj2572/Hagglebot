# Copy to .env.local (never committed). Everything works with no keys: negotiation and payments are mocked.

# Optional: milliseconds to wait between negotiation steps so the dashboard feels live (default 700; 0 = instant).
HAGGLEBOT_STEP_DELAY_MS=700

# Optional: Channel3 product search (real listings and prices). Free key: trychannel3.com/dashboard
CHANNEL3_API_KEY=

# Optional: eBay listings (Browse API, fixed-price and Best Offer, US). Production keyset: developer.ebay.com/my/keys
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Optional: Etsy listings (Open API v3, USD shops only). App key from etsy.com/developers/your-apps
ETSY_API_KEY=
