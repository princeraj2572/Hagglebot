# Copy to .env.local (never committed). SANDBOX credentials only.

# PayPal sandbox app: https://developer.paypal.com/dashboard/applications/sandbox
# Without these two, deals are paid with a labelled mock payment instead of PayPal.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox personal (buyer) account, only shown in the UI as a hint for which account to log in with:
# https://developer.paypal.com/dashboard/accounts
PAYPAL_BUYER_EMAIL=
# Optional payee. It must be the sandbox BUSINESS account that owns the app above (PayPal rejects other
# payees without partner permissions). Leave blank to pay the app's own account.
PAYPAL_SELLER_EMAIL=

# Language model that phrases each message (free tiers). Gemini is used first, Groq when Gemini is rate-limited.
# https://aistudio.google.com/apikey  and  https://console.groq.com/keys
# Without either, templates write the messages.
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional: override the default models if a provider retires one.
# GEMINI_MODEL=
# GROQ_MODEL=

# Optional: milliseconds to wait between negotiation steps so the dashboard feels live (default 700; 0 = instant).
HAGGLEBOT_STEP_DELAY_MS=700

# Optional: Channel3 product search (real listings and prices). Free key: trychannel3.com/dashboard
CHANNEL3_API_KEY=

# Optional: eBay listings (Browse API, fixed-price and Best Offer, US). Production keyset: developer.ebay.com/my/keys
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Optional: Etsy listings (Open API v3, USD shops only). App key from etsy.com/developers/your-apps
ETSY_API_KEY=
